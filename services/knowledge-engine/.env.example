# Copy this file to .env and fill every empty value before starting Docker Compose.
# Empty required values deliberately make `docker compose up` fail.

# Long random secret used to encrypt stored provider credentials.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Password required by the local Web UI and REST API.
OPEN_NOTEBOOK_PASSWORD=

# Local SurrealDB credentials.
SURREAL_USER=intelos
SURREAL_PASSWORD=
