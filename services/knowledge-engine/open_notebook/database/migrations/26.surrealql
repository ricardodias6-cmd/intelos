-- Migration 26: persistent, evidence-linked knowledge graph

DEFINE TABLE IF NOT EXISTS knowledge_entity SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS entity_id ON TABLE knowledge_entity TYPE string;
DEFINE FIELD IF NOT EXISTS canonical_name ON TABLE knowledge_entity TYPE string;
DEFINE FIELD IF NOT EXISTS normalized_name ON TABLE knowledge_entity TYPE string;
DEFINE FIELD IF NOT EXISTS entity_type ON TABLE knowledge_entity TYPE string;
DEFINE FIELD IF NOT EXISTS aliases ON TABLE knowledge_entity TYPE option<array<string>>;
DEFINE FIELD IF NOT EXISTS description ON TABLE knowledge_entity TYPE option<string>;
DEFINE FIELD IF NOT EXISTS metadata ON TABLE knowledge_entity FLEXIBLE TYPE option<object>;
DEFINE FIELD IF NOT EXISTS created ON knowledge_entity DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON knowledge_entity DEFAULT time::now() VALUE time::now();

DEFINE INDEX IF NOT EXISTS idx_knowledge_entity_id
ON TABLE knowledge_entity FIELDS entity_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_knowledge_entity_name
ON TABLE knowledge_entity FIELDS normalized_name, entity_type;

DEFINE TABLE IF NOT EXISTS knowledge_relation
TYPE RELATION FROM knowledge_entity TO knowledge_entity SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS relation_id ON TABLE knowledge_relation TYPE string;
DEFINE FIELD IF NOT EXISTS in ON TABLE knowledge_relation TYPE record<knowledge_entity>;
DEFINE FIELD IF NOT EXISTS out ON TABLE knowledge_relation TYPE record<knowledge_entity>;
DEFINE FIELD IF NOT EXISTS relation_type ON TABLE knowledge_relation TYPE string;
DEFINE FIELD IF NOT EXISTS confidence ON TABLE knowledge_relation TYPE float;
DEFINE FIELD IF NOT EXISTS evidence_ids ON TABLE knowledge_relation TYPE array<string>;
DEFINE FIELD IF NOT EXISTS metadata ON TABLE knowledge_relation FLEXIBLE TYPE option<object>;
DEFINE FIELD IF NOT EXISTS created ON knowledge_relation DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON knowledge_relation DEFAULT time::now() VALUE time::now();

DEFINE INDEX IF NOT EXISTS idx_knowledge_relation_id
ON TABLE knowledge_relation FIELDS relation_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_knowledge_relation_type
ON TABLE knowledge_relation FIELDS relation_type;
DEFINE INDEX IF NOT EXISTS idx_knowledge_relation_endpoints
ON TABLE knowledge_relation FIELDS in, out;

DEFINE TABLE IF NOT EXISTS entity_evidence
TYPE RELATION FROM knowledge_entity TO evidence_block SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS evidence_id ON TABLE entity_evidence TYPE string;
DEFINE FIELD IF NOT EXISTS extractor_version ON TABLE entity_evidence TYPE string;
DEFINE FIELD IF NOT EXISTS confidence ON TABLE entity_evidence TYPE float;
DEFINE FIELD IF NOT EXISTS created ON entity_evidence DEFAULT time::now() VALUE $before OR time::now();

DEFINE INDEX IF NOT EXISTS idx_entity_evidence_id
ON TABLE entity_evidence FIELDS evidence_id;
DEFINE INDEX IF NOT EXISTS idx_entity_evidence_endpoints
ON TABLE entity_evidence FIELDS in, out;

DEFINE EVENT IF NOT EXISTS intelos_knowledge_entity_delete
ON TABLE knowledge_entity
WHEN ($after == NONE)
THEN {
    DELETE knowledge_relation WHERE in == $before.id OR out == $before.id;
    DELETE entity_evidence WHERE in == $before.id;
};

DEFINE EVENT IF NOT EXISTS intelos_knowledge_evidence_delete
ON TABLE evidence_block
WHEN ($after == NONE)
THEN {
    DELETE entity_evidence WHERE out == $before.id;
};
